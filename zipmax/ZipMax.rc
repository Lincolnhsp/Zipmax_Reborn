/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ZIPMAX_DIALOG DIALOGEX 0, 0, 333, 129
STYLE DS_SETFONT | DS_SETFOREGROUND | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | 
    WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION "ZipMax"
MENU IDR_MAINMENU
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "List1",IDC_LIST,"SysListView32",LVS_REPORT | 
                    LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | 
                    WS_TABSTOP,19,18,308,63
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",WS_BORDER,4,
                    85,310,10
    LTEXT           "",IDC_STATUS1,4,99,323,10,SS_SUNKEN
    LTEXT           "",IDC_STATUS2,4,113,323,10,SS_SUNKEN
    DEFPUSHBUTTON   "",IDC_BUTTON1,4,7,13,10,NOT WS_VISIBLE
    PUSHBUTTON      "P",IDC_BUTTON_PAUSE,317,85,10,10
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu (the texts are translated at run time from the language files, see CZipMaxDlg::ApplyMenuLanguage)
//

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Add &Files...",               IDM_FILE_ADDFILES
        MENUITEM "Add F&older...",              IDM_FILE_ADDFOLDER
        MENUITEM "Add Folder with &Subfolders...", IDM_FILE_ADDFOLDERSUB
        MENUITEM SEPARATOR
        MENUITEM "&Clear List",                 IDM_FILE_CLEARLIST
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_FILE_EXIT
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Options (zipmax.ini)...",    IDM_SET_OPTIONS
        MENUITEM "&Dialog Box...",              IDM_SET_VIEW
        MENUITEM SEPARATOR
        POPUP "&Language"
        BEGIN
            MENUITEM "English",                 IDM_LANG_FIRST
        END
    END
    POPUP "&About"
    BEGIN
        MENUITEM "&About ZipMax Reborn...",     IDM_HELP_ABOUT
    END
END


