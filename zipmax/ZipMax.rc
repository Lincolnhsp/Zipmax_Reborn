    COMBOBOX        IDC_OPT_COMBO,50,158,226,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...",IDC_OPT_BROWSE,280,157,53,14
    LTEXT           "",IDC_OPT_HINT,7,177,326,24
    PUSHBUTTON      "Add Packer",IDC_OPT_ADDPACKER,7,206,80,14
    PUSHBUTTON      "Remove Last Packer",IDC_OPT_REMOVEPACKER,92,206,100,14
    DEFPUSHBUTTON   "OK",IDOK,222,228,52,14
    PUSHBUTTON      "Cancel",IDCANCEL,281,228,52,14
END


